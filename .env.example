# Prism-Core base URL for agent registration/invocation
PRISM_CORE_BASE_URL=http://localhost:8000

# Target agent name to invoke via Prism-Core
PRISM_AGENT_NAME=autonomous_control_agent

# Optional legacy credentials (not required for Prism-Core by default)
BIMATRIX_ID=
BIMATRIX_PW=

# HTTP client settings
REQUEST_TIMEOUT=30
VERIFY_SSL=false
